# Copy these into your hosting provider's environment settings (or export them before `npm start`).
# Never commit real values.

PORT=3000

# Admin account, created on the FIRST start only (when no admin exists yet).
# If ADMIN_PASSWORD is not set, a random password is generated and printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password

# Public address of the site; used in password-reset links.
PUBLIC_URL=https://your-domain.example

# Google sign-in. Create an OAuth "Web" client in Google Cloud Console and add your site's URL under
# "Authorized JavaScript origins". Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=

# ---- Email (required for customer registration OTP and password reset) ----
# Option 1: Resend API (recommended — sign up free at resend.com)
RESEND_API_KEY=

# Option 2: Webhook relay (set MAIL_WEBHOOK_URL to an HTTPS endpoint accepting POST {to, subject, text})
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# Option 3: SMTP (e.g. Gmail, Mailgun SMTP, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Umaira Florist <noreply@example.com>

# ---- Cloudinary (required for admin image uploads — product photos, GCash QR, proof-of-delivery) ----
# Sign up free at cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Reverse proxy (REQUIRED on Render, Heroku, Railway, and any host with a load balancer) ----
# Without this, rate limits and the admin sign-in lockout treat all visitors as the same IP.
TRUST_PROXY=1

# ---- Optional tuning ----
# UMAIRA_DATA_DIR=./data      # where umaira.db and payment-receipts are stored (back this up)
# ORDER_RATE_LIMIT=20         # orders per customer per minute
# PAYMENT_PROOF_RATE_LIMIT=6  # payment-proof uploads per customer per 10 minutes
# MAIL_FROM=Umaira Florist Atelier <onboarding@resend.dev>  # sender name and address
