# Copy these into your hosting provider's environment settings (or export them before `npm start`).
# Never commit real values.

PORT=3000

# Admin account, created on the FIRST start only (when no admin exists yet).
# If ADMIN_PASSWORD is not set, a random password is generated and printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password

# Google sign-in. Create an OAuth "Web" client in Google Cloud Console and add your site's URL under
# "Authorized JavaScript origins". Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=

# Public address of the site; used in password-reset links.
PUBLIC_URL=https://your-domain.example

# Optional: password-reset email only. Order and payment updates are in-app notifications (customer account
# bell and Admin console) and never need email, so the shop works fully without these settings.
# Without MAIL_WEBHOOK_URL, password-reset links are printed to the server log (development only).
# Point it at an HTTPS endpoint that accepts POST {to, subject, text} as JSON.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# Reverse proxy: number of proxies in front of the app (usually 1 for nginx/Caddy/most hosts).
# Required behind a proxy, otherwise every visitor shares one admin sign-in lockout (8 failed tries / 15 min).
# Leave unset when visitors connect to Node directly — then X-Forwarded-For is ignored (it can be forged).
# TRUST_PROXY=1

# Optional
# UMAIRA_DATA_DIR=./data      # where umaira.db is stored (back this up)
# ORDER_RATE_LIMIT=20         # orders per customer per minute
# PAYMENT_PROOF_RATE_LIMIT=6  # payment-proof uploads per customer per 10 minutes
