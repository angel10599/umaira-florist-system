# ─────────────────────────────────────────────────────────────────────────────
# Umaira Florist — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Turso/LibSQL) ───────────────────────────────────────────────────
# Get these from https://turso.tech → Dashboard → your database → Connect
# Leave blank to use a local SQLite file at data/umaira.db (dev only).
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Admin Account ─────────────────────────────────────────────────────────────
# Created automatically on first start if the admin table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# ── Email (choose one) ────────────────────────────────────────────────────────
# Option A — Resend (recommended for Vercel): https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option B — Webhook relay (any HTTP endpoint that accepts JSON POST)
# MAIL_WEBHOOK_URL=https://your-email-relay.example.com/send
# MAIL_WEBHOOK_TOKEN=optional-bearer-token

# From address used in all outgoing email
# MAIL_FROM=Umaira Florist Atelier <onboarding@resend.dev>

# ── Google Sign-In (optional) ─────────────────────────────────────────────────
# Create a Web client ID at https://console.cloud.google.com/apis/credentials
# Leave blank to disable Google login.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── File Uploads (Cloudinary, optional) ───────────────────────────────────────
# Without these, receipt uploads are stored locally (not suitable for Vercel).
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Public URL ────────────────────────────────────────────────────────────────
# Used in email links. Auto-detected from the request Host header if not set.
# PUBLIC_URL=https://your-domain.vercel.app

# ── Server (usually set automatically by the host) ────────────────────────────
# PORT=3000
# TRUST_PROXY=1

# ── Rate Limits (optional overrides) ─────────────────────────────────────────
# ORDER_RATE_LIMIT=20          # max orders per customer per minute
# PAYMENT_PROOF_RATE_LIMIT=6  # max payment proof uploads per 10 minutes
